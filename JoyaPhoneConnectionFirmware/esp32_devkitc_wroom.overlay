/ {
    aliases {
        boton-emergencia = &boton_esp;
    };

    /* Define button node */
    botones_joya {
        compatible = "gpio-keys";

        boton_esp: boton_0 {
            gpios = <&gpio0 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "Test Button ESP32";
        };
    };

    /* For printk */
    chosen {
        zephyr,console = &uart0;
        zephyr,shell-uart = &uart0;
    };
};

/* Serial port 0 - 115200 */
&uart0 {
    status = "okay";
    current-speed = <115200>;
};
