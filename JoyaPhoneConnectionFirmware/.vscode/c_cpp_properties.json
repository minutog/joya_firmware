{
    "configurations": [
        {
            "name": "Zephyr_Live",
            "includePath": [
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/include/**",
                "${workspaceFolder}/zephyr_base/zephyr/include/**",
                "${workspaceFolder}/zephyr_base/zephyr/lib/libc/minimal/include/**"
            ],
            "defines": [
                "CONFIG_SOC_ESP32",
                "__ZEPHYR__=1"
            ],
            "cStandard": "c11",
            "intelliSenseMode": "linux-gcc-x64",
            "compilerPath": "/usr/bin/gcc"
        }
    ],
    "version": 4
}