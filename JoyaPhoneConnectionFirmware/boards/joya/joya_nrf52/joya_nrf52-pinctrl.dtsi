#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

&pinctrl {
	i2c0_default: i2c0_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 8)>,
				<NRF_PSEL(TWIM_SCL, 0, 6)>;

			/*
			* Joya PCB rev. actual has no external I2C pull-up resistors.
			* Internal nRF52 pull-ups are enabled to keep SDA/SCL defined.
			*
			* Hardware note: external pull-ups are recommended for a more robust I2C bus
			* in future PCB revisions.
			*/
			bias-pull-up;
		};
	};

	i2c0_sleep: i2c0_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 8)>,
				<NRF_PSEL(TWIM_SCL, 0, 6)>;
			low-power-enable;
		};
	};
};
