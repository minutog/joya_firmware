{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug + RTT console (DK -> custom PCB)",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/${workspaceFolderBasename}/zephyr/zephyr.elf",
      "servertype": "jlink",
      "device": "nRF52832_xxAA",
      "interface": "swd",
      "serialNumber": "${input:dkSerial}",
      "preLaunchTask": "Build firmware",
      "rttConfig": {
        "enabled": true,
        "address": "auto",
        "decoders": [
          {
            "label": "RTT",
            "port": 0,
            "type": "console"
          }
        ]
      }
    }
  ],
  "inputs": [
    {
      "id": "dkSerial",
      "type": "promptString",
      "description": "Enter your DK debug serial number (same value used for flash)"
    }
  ]
}
